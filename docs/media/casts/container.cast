[0.000, "o", "container \u001b[36macme-web\u001b[0m\r\n\r\n"]
[0.000, "o", "\u001b[33mthis is one-way: the transcript moves into the container's store, and\u001b[0m\r\n"]
[0.000, "o", "\u001b[33mthe session is resumed there from now on. reading it stays unchanged.\u001b[0m\r\n"]
[0.002, "o", "\u001b[1G"]

[1.119, "o", "\r\n\u001b[32mcontainerized\u001b[0m \u001b[36m2690cd0d-8\u001b[0m \u001b[2m→\u001b[0m \u001b[36macme-web\u001b[0m\r\n  ports     20000-20004\r\n"]
[0.000, "o", "  claude    \u001b[32mseeded\u001b[0m \u001b[2mfrom ~/.claude/.credentials.json\u001b[0m\r\n"]
[0.000, "o", "\u001b[2m            access token only, so it cannot rotate your host login.\u001b[0m\r\n"]
[0.000, "o", "\u001b[2m            expires in 6.3h; casm refreshes it on the next resume\u001b[0m\r\n\r\nresume it with: \u001b[36mcasm resume 2690cd0d-8\u001b[0m\r\n"]

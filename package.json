{
  "name": "casm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:npm": "node scripts/package-npm.ts",
    "test:npm": "node --test scripts/package-npm.test.ts",
    "build": "npm run build -w @casm/web",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json && npm run typecheck -w @casm/web",
    "test": "node --test 'packages/*/test/*.test.ts'",
    "dev": "node scripts/dev.ts",
    "dev:server": "node scripts/dev.ts serve",
    "schema": "node packages/protocol/scripts/export-schema.ts",
    "coverage": "node scripts/coverage/run.ts",
    "setup": "scripts/install.sh",
    "service": "scripts/service.sh"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
